# Backend API base URL (the server's PORT + /api). The browser calls it directly, so this
# app's origin (http://localhost:5173) must be in the server's CORS_WHITELIST.
VITE_API_URL=http://localhost:8080/api

# true = answer every API call from the in-browser demo data (no backend needed).
VITE_USE_MOCKS=false

# With the real API, endpoints the backend has not built yet (dashboard, projects,
# work items...) are answered from demo data instead of failing with 404.
# The built ones are listed in BACKEND_PATHS in src/app/mockFallback.ts. false = real API only.
VITE_MOCK_MISSING_ENDPOINTS=true
